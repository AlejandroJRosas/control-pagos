{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Control de Pagos",
  "version": "../package.json",
  "identifier": "com.controlpagos.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Control de Pagos",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5ODgyQjY2QjVBNkQzMTcKUldRWDA2YTFaaXVJaVh0aEdqYThoZFloS0FwYVRCbmJwQ3VnVXdmQys1OFR5LytHU2V6VkE3dVoK",
      "endpoints": [
        "https://github.com/AlejandroJRosas/control-pagos/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
